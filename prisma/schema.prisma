generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String
  genre       String?
  isbn        String?  @unique
  price       Decimal? @db.Decimal(10, 2)
  description String?
  coverUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([title])
  @@index([author])
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String
  name         String?
  email        String?
  homeAddress  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  creditCards  CreditCard[]
}

model CreditCard {
  id        String   @id @default(cuid())
  userId    String
  last4     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
