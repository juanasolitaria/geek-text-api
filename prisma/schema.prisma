generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String
  genre       String?
  isbn        String?  @unique
  price       Decimal? @db.Decimal(10, 2)
  description String?
  coverUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cartItems CartItem[]

  @@index([title])
  @@index([author])
}

// Feature 3 — Shopping Cart (owned by Juan)
model CartItem {
  id      String   @id @default(cuid())
  userId  String
  bookId  String
  addedAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id])

  @@unique([userId, bookId])
  @@index([userId])
}
